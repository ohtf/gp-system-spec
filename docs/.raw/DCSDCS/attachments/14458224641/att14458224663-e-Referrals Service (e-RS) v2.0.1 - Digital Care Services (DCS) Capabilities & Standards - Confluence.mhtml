x; text-decoration: none; background-image: none; outline: 0px; cursor: poi=
nter; user-select: none; }

#cp-file-control-companion-edit:hover, #cp-file-control-companion-edit:focu=
s { background-color: rgb(112, 112, 112); }

#cp-file-control-companion-edit .aui-icon { margin-left: 4px; margin-bottom=
: 4px; }

.companion-dd.connected { display: block; }

.companion-dd.not-connected { display: none !important; }

.companion-dd { background-color: rgb(255, 255, 255); border-radius: 4px; c=
ursor: default; padding: 16px !important; margin-top: 4px !important; }

.companion-dd > li { background-color: rgb(255, 255, 255) !important; }

.companion-dd > li.app { display: none; }

.companion-dd > li.non-app { display: list-item; }

.companion-dd.apps-list > li.app { display: list-item; }

.companion-dd.apps-list > li.non-app { display: none; }

.companion-dd > li > a { background-color: rgb(0, 82, 204); border-radius: =
4px; cursor: pointer; padding: 0px 16px !important; }

.companion-dd > li > a:hover { background-color: rgb(0, 101, 255); }

