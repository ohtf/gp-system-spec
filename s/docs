#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Open the catalogue, or use --mirror to preview the local July NHS capture.
# Binds the first free port in 8000-8030. Pass -a/--dev-addr to override.
# The browser opens after the homepage is available, not just after binding.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
config=mkdocs.yml
if [[ ${1:-} == --mirror ]]; then
  config=mkdocs-mirror.yml
  shift
fi
if ! command -v zensical >/dev/null 2>&1; then
  printf '%s\n' 'Install Zensical with: python3 -m pip install -r requirements.txt' >&2
  exit 1
fi

addr=
args=()
while (($#)); do
  case "$1" in
    --help) exec zensical serve --help ;;
    -o|--open) ;; # This wrapper already opens the browser.
    -a|--dev-addr)
      if (($# < 2)); then exec zensical serve -f "$config" "$1"; fi
      addr=$2
      shift ;;
    -a=*|--dev-addr=*) addr=${1#*=} ;;
    -a?*) addr=${1#-a} ;;
    *) args+=("$1") ;;
  esac
  shift
done

listening() {
  local port=$1
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk -v port="$port" '$4 ~ "[:.]" port "$" { found=1 } END { exit !found }'
  elif command -v lsof >/dev/null 2>&1; then
    lsof -iTCP="${port}" -sTCP:LISTEN -Pn >/dev/null 2>&1
  else
    (exec 3<>"/dev/tcp/127.0.0.1/${port}") >/dev/null 2>&1
  fi
}

if [[ -z $addr ]]; then
  for ((port=8000; port<=8030; port++)); do
    if ! listening "$port"; then
      addr="127.0.0.1:$port"
      break
    fi
  done
  if [[ -z $addr ]]; then
    printf '%s\n' 's/docs: no free port in 8000-8030' >&2
    exit 1
  fi
fi

# Only Zensical knows the assigned address when the OS chooses the port.
if [[ ${addr##*:} =~ ^0+$ ]]; then
  exec zensical serve -f "$config" --dev-addr "$addr" --open "${args[@]}"
fi

case "$addr" in
  0.0.0.0:*) url="http://127.0.0.1:${addr##*:}/" ;;
  \[::\]:*) url="http://[::1]:${addr##*:}/" ;;
  *) url="http://$addr/" ;;
esac
printf 's/docs: waiting for the homepage at %s before opening the browser\n' "$url"
python3 tools/open-preview.py "$url" "$$" &
exec zensical serve -f "$config" --dev-addr "$addr" "${args[@]}"
