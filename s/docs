#!/usr/bin/env bash
# Open a local preview of the July NHS Confluence capture.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! command -v zensical >/dev/null 2>&1; then
  printf '%s\n' 'Install Zensical with: python3 -m pip install -r requirements.txt' >&2
  exit 1
fi
exec zensical serve --dev-addr 127.0.0.1:8000 --open "$@"
