#!/usr/bin/env bash
# Generate or check the local GP IT Futures reference. Install requirements.txt first.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! python3 -c 'import bs4, markdown, markdownify, yaml' >/dev/null 2>&1; then
  printf '%s\n' 'Install extraction dependencies: python3 -m pip install -r requirements.txt' >&2
  exit 1
fi
exec python3 tools/extract_spec.py "$@"
